    {
      "parameters": {
        "jsCode": "// Pull the few fields we need out of the raw Stripe webhook body.\n// We deliberately do NOT trust anything else in this payload - the next step\n// re-fetches the checkout session straight from Stripe's API.\nconst body = $json.body ?? {};\n\nreturn [{\n  json: {\n    event_id: body.id ?? '',\n    event_type: body.type ?? '',\n    session_id: body.data?.object?.id ?? '',\n  },\n}];"
      },
      "id": "0f1d2c3b-4a59-4e6f-8a7b-000000000007",
      "name": "Extract Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
