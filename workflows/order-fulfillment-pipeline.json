            {
              "id": "0f1d2c3b-4a59-4e6f-8a7b-000000000008",
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "checkout.session.completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
